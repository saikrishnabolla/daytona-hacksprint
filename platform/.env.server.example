# Server-side credentials for the pentest orchestrator (server/index.mjs).
# Copy to .env.server and fill in. This file is committed; .env.server is gitignored.

# --- Daytona (isolated sandboxes running Juice Shop + ZAP) ---
DAYTONA_API_KEY=
# Optional: override region/API endpoint
# DAYTONA_TARGET=us
# DAYTONA_API_URL=https://app.daytona.io/api

# --- Target + scanner images ---
# The app and OWASP ZAP run together in ONE sandbox and talk over localhost,
# because a sandbox cannot reach another sandbox's preview URL.
# TARGET_APP=juice-shop        # juice-shop | demo-repo | synthetic-help-center
# JUICE_SHOP_IMAGE=bkimminich/juice-shop:latest
# ZAP_IMAGE=ghcr.io/zaproxy/zaproxy:stable

# --- Repo target (TARGET_APP=demo-repo): clone, build and scan any git repo ---
# Provide DEMO_REPO_URL (real demo) OR DEMO_REPO_LOCAL_DIR (offline fallback).
# The bundled ../demo-repo is an authenticated app with several planted issues; the
# values below match it and are a good template for your own repo.
# DEMO_REPO_URL=https://github.com/you/vulnerable-demo.git
# DEMO_REPO_LOCAL_DIR=../demo-repo
# DEMO_REPO_BRANCH=main
# DEMO_REPO_LABEL=My App
# DEMO_REPO_PORT=3000
# DEMO_REPO_INSTALL=npm ci --no-audit --no-fund
# DEMO_REPO_START=npm start
# DEMO_REPO_HEALTH=/health
# DEMO_REPO_HEALTH_FIELD=version
# Comma-separated paths ZAP seeds before scanning (blank query values are fine):
# DEMO_REPO_SEEDS=/search?q=workspace,/dashboard?q=workspace,/go?next=https://example.com/
# Which URLs are in scope (regex appended to the base URL). Include the login page too:
# DEMO_REPO_INCLUDE=/(?:search|dashboard|login|go|notes|$)
# DEMO_REPO_RULES=40012
# Active-scan ceiling in seconds:
# DEMO_REPO_SCAN_SECONDS=240
# Authenticated browser proof (Anchor logs in, then visits the proof URL):
# DEMO_REPO_PARAM=q
# DEMO_REPO_PROOF_PATH=/dashboard
# DEMO_REPO_PAYLOAD=<img src=x onerror=alert("demo-proof")>
# DEMO_REPO_DIALOG=demo-proof
# Authenticated scan (ZAP logs in to reach the private area):
# DEMO_REPO_EMAIL=analyst@acme.test
# DEMO_REPO_PASSWORD=demo1234
# DEMO_REPO_LOGIN_PATH=/login
# DEMO_REPO_LOGIN_REQUEST=email={%username%}&password={%password%}
# DEMO_REPO_LOGIN_EMAIL_FIELD=input[name=email]
# DEMO_REPO_LOGIN_PASSWORD_FIELD=input[name=password]
# DEMO_REPO_LOGIN_SUBMIT=button[type=submit]
# DEMO_REPO_LOGGED_IN_INDICATOR=Sign out
# One-line fix for the repair loop (patch + version bump):
# DEMO_REPO_PATCH_FILE=server.js
# DEMO_REPO_PATCH_BEFORE=const termHtml = term
# DEMO_REPO_PATCH_AFTER=const termHtml = escapeHtml(term)
# DEMO_REPO_PATCH_VULNERABLE_VERSION=1.2.0-vulnerable
# DEMO_REPO_PATCH_FIXED_VERSION=1.2.0-fixed
# Per-sandbox resources for ad-hoc repo runs (boot several in parallel):
# Daytona's org memory cap is 10 GiB total, so 2 GiB each lets three fit.
# REPO_MEMORY=2
# REPO_CPU=1
# REPO_DISK=8

# --- Anchor Browser (authenticated browser verification) ---
ANCHOR_API_KEY=

# --- Arize (OTLP traces) ---
ARIZE_API_KEY=
ARIZE_SPACE_ID=
# ARIZE_PROJECT_NAME=session-workspace

# --- SurrealDB Agent Memory (shared findings) ---
SURREAL_MEMORY_API_KEY=
SURREAL_MEMORY_CONTEXT_ID=
SURREAL_MEMORY_HOST=

# --- AWS Bedrock (open-source models for analysis + fix proposals) ---
AWS_DEFAULT_REGION=us-west-2
AWS_REGION=us-west-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
MODEL_PROVIDER=bedrock
# Confirmed working on this account: deepseek.v3.2, deepseek.v3-v1:0, zai.glm-5.
# zai.glm-5.3 exists on Bedrock but is not enabled for the account yet (request access in the console).
MODEL_ID=deepseek.v3.2

# --- Orchestrator ---
# API_PORT=8787
